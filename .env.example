# Copy to .env and fill in. Both are OPTIONAL if you have run `guava login`
# (the SDK falls back to CLI credentials automatically).

# From https://app.goguava.ai/dashboard/api-keys
GUAVA_API_KEY=gva-...

# From https://app.goguava.ai/dashboard/phone-numbers  (or: guava numbers buy)
# Required for inbound listening and outbound calls.
GUAVA_AGENT_NUMBER=+14155550123

# Optional: fallback number used for roster witnesses added without one, so the
# "Call witness" button is usable in a demo. Never commit a real number.
# DEMO_WITNESS_PHONE=+15551234567

# Analysis backbone. Falls back to the deterministic engine if absent.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Dashboard port
PORT=3000
