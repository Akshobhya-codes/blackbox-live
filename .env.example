# Copy to .env. Everything here is optional — BlackBox runs the full demo with
# an empty file, and the dashboard labels each integration as live or demo.

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------
# true  (default) deterministic interviews, no real calls placed
# false            use the configured voice provider for real
DEMO_MODE=true
PORT=3000

# ---------------------------------------------------------------------------
# Analysis + memory  (one key powers three things)
# ---------------------------------------------------------------------------
# Used for: claim/contradiction analysis cross-checked against the rules
# engine, Cognee's entity extraction, and the Strands Report Agent.
# Without it, the deterministic rules engine runs alone and everything still
# works — you simply get fewer findings on unfamiliar vocabulary.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Bright Data — public context that can corroborate or challenge an account
# ---------------------------------------------------------------------------
# From https://brightdata.com → account settings → API tokens.
# Absent: labelled `demo_fixture` sources are used and shown as such.
BRIGHTDATA_API_TOKEN=

# ---------------------------------------------------------------------------
# Amazon Bedrock — the model behind the Strands Report Agent
# ---------------------------------------------------------------------------
# Strands is AWS's agent SDK and Bedrock is its native provider. Set either a
# Bedrock API key (bearer token, simplest) OR ordinary AWS credentials, and
# the report is generated on Bedrock. Claim extraction and contradiction
# analysis stay on OpenAI regardless — only the report moves.
#
# With none of these set, the Report Agent falls back to OPENAI_API_KEY and
# the service behaves exactly as before. /health always names the provider
# actually in use, so the integration is never taken on trust.
AWS_BEDROCK_API_KEY=
# ...or SigV4 credentials instead of the bearer token:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Brain service (Cognee + Strands)
# ---------------------------------------------------------------------------
# Where the Python service listens. Start it with: npm run brain
BRAIN_URL=http://127.0.0.1:8077
BRAIN_PORT=8077

# Hosted Cognee tenant. When both are set the brain service talks to the hosted
# graph over its REST API instead of building a local store.
COGNEE_API_URL=
COGNEE_API_KEY=

# Local-SDK fallback only. Cognee writes a vector + graph store to disk. Keep this OUT of any synced
# folder (OneDrive/Dropbox) and out of paths containing spaces — LanceDB
# cannot persist there and cognify fails with an opaque IO error.
COGNEE_STORAGE_DIR=

# ---------------------------------------------------------------------------
# Voice provider (only used when DEMO_MODE=false)
# ---------------------------------------------------------------------------
GUAVA_API_KEY=
GUAVA_AGENT_NUMBER=
