{
  "name": "blackbox",
  "version": "1.0.0",
  "description": "Autonomous incident reconstruction — interviews everyone involved, reconciles their accounts with real-world evidence, and builds a source-traceable timeline.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "prestart": "vite build",
    "dev": "concurrently -k -n ui,api,brain -c cyan,green,magenta npm:ui npm:dev:api npm:brain",
    "predev": "vite build",
    "dev:api": "tsx watch src/server.ts",
    "ui": "vite build --watch",
    "build": "vite build",
    "brain": "node scripts/brain.mjs",
    "test": "tsx src/selftest.ts && tsx src/casetest.ts",
    "selftest": "tsx src/selftest.ts",
    "casetest": "tsx src/casetest.ts",
    "typecheck": "tsc --noEmit",
    "chat": "tsx src/agent-cli.ts --chat",
    "roleplay": "tsx src/agent-cli.ts --roleplay"
  },
  "keywords": [
    "incident-reconstruction",
    "cognee",
    "bright-data",
    "strands",
    "voice-ai",
    "investigation"
  ],
  "license": "MIT",
  "dependencies": {
    "@guava-ai/guava-sdk": "^0.33.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^13.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reactflow": "^11.11.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  }
}